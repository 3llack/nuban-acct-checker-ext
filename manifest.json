{
  "manifest_version": 3,
  "name": "Account Checker",
  "version": "0.1.0",
  "description": "Check that each account number in your salary sheet belongs to the right bank and person before you pay.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Open Account Checker",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "side_panel": { "default_path": "src/panel.html" },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["sidePanel", "scripting"],
  "host_permissions": ["https://docs.google.com/spreadsheets/*", "https://*.googleusercontent.com/*"]
}
