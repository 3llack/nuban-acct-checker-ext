# Copy to server/.env (git ignores it) and fill in. Never commit real keys.
# Monnify is asked first. Monnify dashboard > Developers: API key and secret key.
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=

# Live: https://api.monnify.com. Sandbox (testing only): https://sandbox.monnify.com
MONNIFY_BASE_URL=https://api.monnify.com

# Optional backup when Monnify cannot answer. Paystack dashboard > Settings > API Keys & Webhooks: the LIVE secret key.
PAYSTACK_SECRET_KEY=

# Which lookup is asked first. Default: monnify,paystack
# LOOKUP_ORDER=monnify,paystack
PORT=8787

# Comma separated. Use the exact chrome-extension://<id> in production.
ALLOWED_ORIGINS=chrome-extension://*
LIMIT_PER_MINUTE=120
LIMIT_PER_DAY=1000
# Lookups per day across everyone, to protect the provider keys.
LIMIT_GLOBAL_PER_DAY=20000
# Lookups without an allowed extension Origin get 403. Set to 0 only to test with curl.
REQUIRE_ORIGIN=1

# Set to 1 only behind a proxy that sets X-Forwarded-For.
TRUST_PROXY=0
